{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run assistant (offline)",
      "type": "shell",
      "command": "python backend.py",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Run assistant (offline, port 8081)",
      "type": "shell",
      "command": "python backend.py --port 8081",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "python -m unittest discover -s tests -v",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Run terminal chat (CLI)",
      "type": "shell",
      "command": "python backend.py --cli",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
